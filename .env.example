# Segredos para docker-compose.prod.yml
# Copie este arquivo para .env e ajuste os valores.
# NÃO comite o .env — ele já está no .gitignore.

# --- Banco ---
POSTGRES_USER=essencia
POSTGRES_PASSWORD=
POSTGRES_DB=essencia

# --- App ---
# Gere com: openssl rand -hex 32
JWT_SECRET=
FRONTEND_URL=http://localhost
HTTP_PORT=80

# --- Stripe Connect ---
# true = modo demo (nada é cobrado). false = live, requer STRIPE_SECRET_KEY
STRIPE_MOCK=true
STRIPE_SECRET_KEY=
PLATFORM_FEE_PCT=10

# --- Web Push (VAPID) ---
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@essencia-do-cuidar.app