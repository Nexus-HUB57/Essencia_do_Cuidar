# Arquivos que não devem triggerar um build na Netlify.
#
# A CI no GitHub (.github/workflows/ci.yml) é a fonte de verdade — se ela
# falhar, a Netlify não deve publicar código quebrado.
#
# ATENÇÃO: NÃO exclua frontend/package-lock.json aqui. A Netlify roda
# `npm ci` e precisa do lockfile, senão o build falha com EUSAGE.

backend/**
scripts/**
.github/**
*.md
.gitignore
docker-compose.yml
netlify.toml
backend/Dockerfile
backend/.dockerignore
frontend/.env.example
frontend/.env.production
frontend/.env.local