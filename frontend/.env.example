# Frontend — variáveis de ambiente
#
# Copie para .env.production (ou defina direto no painel da Netlify em
# Site settings → Environment variables) ANTES do build.
#
# IMPORTANTE: variáveis VITE_* são embutidas no bundle em tempo de BUILD.
# Mudar a variável exige rebuild, não só restart.

# URL da API do backend.
# Opção A — mesma origem (usando os redirects de proxy do netlify.toml):
#           deixa "/api" e o netlify.toml encaminha pro backend real
VITE_API_URL=/api

# Opção B — backend direto (descomente se NÃO usar proxy):
# VITE_API_URL=https://essencia-backend.onrender.com/api