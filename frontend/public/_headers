# frontend/public/_headers — Headers de segurança + cache (fallback)
# Lido pelo Netlify se netlify.toml não definir headers para uma rota.

# Segurança aplicada a todas as rotas
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Assets com hash (Vite) — cache 1 ano
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker — nunca cacheado
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Manifest PWA
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Imagens da marca — cache 7 dias
/img/*
  Cache-Control: public, max-age=604800

# Favicon — cache 7 dias
/favicon.svg
  Cache-Control: public, max-age=604800
