# Configuração do servidor
PORT=4000
NODE_ENV=development

# Banco de dados
# Default dev: SQLite em ./data/essencia.db
# Prod: setar DATABASE_URL (formato postgres://user:pass@host:5432/db)
# DATABASE_URL=postgres://essencia:senha@localhost:5432/essencia
# PGSSL=true   # só se o servidor PG exigir SSL
# AUTO_VERIFICAR_REGISTROS=true   # dev: aprova registros automaticamente

# JWT
JWT_SECRET=essencia-do-cuidar-trocar-em-producao-use-uma-chave-aleatoria-de-64-chars-min
JWT_EXPIRES_IN=7d

# CORS - URL do frontend (separar múltiplas com vírgula)
FRONTEND_URL=http://localhost:5173

# Integração netlify.ai (webhook simulado)
NETLIFY_AI_URL=https://netlify.ai
NETLIFY_AI_TIMEOUT_MS=5000

# Uploads
MAX_UPLOAD_MB=5
UPLOAD_DIR=./uploads

# Feature 3 — Stripe Connect (deixe vazio + STRIPE_MOCK=true para modo demo)
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_MOCK=true
PLATFORM_FEE_PCT=10

# Feature 4 — Web Push (VAPID). Gere com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@essencia-do-cuidar.app
