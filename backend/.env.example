# ════════════════════════════════════════════════════════════════════
#  Essência do Cuidar — variáveis de ambiente (backend)
# ════════════════════════════════════════════════════════════════════
#  Copie para `.env` (gitignored) e ajuste conforme o ambiente.
#
#  Por padrão o app roda em modo dev (SQLite local, porta 4000) sem
#  precisar de nenhuma configuração além do JWT_SECRET.
# ════════════════════════════════════════════════════════════════════

# ─── Servidor ────────────────────────────────────────────────────────
# Porta que o backend escuta. Render injeta PORT=10000 — não fixar.
PORT=4000
# development | production | test
NODE_ENV=development

# ─── Banco de dados ──────────────────────────────────────────────────
# Em dev: SQLite em ./data/essencia.db (default, sem env var)
# Em prod: setar DATABASE_URL no formato postgres://user:pass@host:5432/db
# DATABASE_URL=postgres://essencia:senha@localhost:5432/essencia
# PGSSL=true   # só se o servidor PG exigir SSL
# AUTO_VERIFICAR_REGISTROS=true   # dev: aprova registros automaticamente

# ─── JWT (autenticação) ──────────────────────────────────────────────
# IMPORTANTE: em produção, gerar uma chave aleatória de pelo menos 64
# caracteres. Ex.: `openssl rand -hex 32` ou `node -e "console.log(crypto.randomBytes(48).toString('hex'))"`
# Se vazio, o app usa o fallback de dev "dev-secret-trocar" e loga
# warning na inicialização.
JWT_SECRET=essencia-do-cuidar-trocar-em-producao-use-uma-chave-aleatoria-de-64-chars-min
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────
# Origens do frontend permitidas (separar múltiplas com vírgula).
# Em produção, setar para o domínio público (ex.: https://essencia.netlify.app)
FRONTEND_URL=http://localhost:5173

# ─── Webhook netlify.ai (notificação) ────────────────────────────────
# Endpoint chamado em cada vaga/candidatura criada. Falha é
# best-effort e registrada em webhook_logs — não bloqueia o fluxo.
NETLIFY_AI_URL=https://netlify.ai
NETLIFY_AI_TIMEOUT_MS=5000

# ─── Uploads (diploma, conselho, etc) ────────────────────────────────
MAX_UPLOAD_MB=5
UPLOAD_DIR=./uploads

# ─── Rate limiting (segurança) ───────────────────────────────────────
# Geral: 300 req / 15 min por IP em /api/* (descomente para ajustar)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=900000
# /api/auth/* : 30 req / 15 min (anti brute-force)
# RATE_AUTH_MAX=30
# Em dev, se quiser desligar: RATE_LIMIT_DISABLED=1
# RATE_LIMIT_DISABLED=1

# ─── Feature 3 — Stripe Connect (pagamentos) ─────────────────────────
# Deixe vazio + STRIPE_MOCK=true para modo demo (sem chamada real à Stripe).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MOCK=true
PLATFORM_FEE_PCT=10

# ─── Feature 4 — Web Push (VAPID) ───────────────────────────────────
# Gere chaves com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@essencia-do-cuidar.app

# ─── i18n ────────────────────────────────────────────────────────────
# Idioma padrão e lista de idiomas suportados no /api/i18n
# I18N_DEFAULT=pt-BR
# I18N_LOCALES=pt-BR,es,en

# ════════════════════════════════════════════════════════════════════
#  Variaveis adicionadas nos Sprints 1-3 (recuperadas via PR #17/#18)
# ════════════════════════════════════════════════════════════════════

# ─── Sprint 1 — Matching + auto-close ──────────────────────────────
# Auto-close da vaga apos primeiro aceite (default: true)
# Setar AUTO_CLOSE_ON_ACCEPT=false para permitir multiplas candidaturas
AUTO_CLOSE_ON_ACCEPT=true

# ─── Sprint 3 — Auth avancada (A1/A2) ───────────────────────────────
# Duracao do access token (default 15min) — curto para minimizar
# dano se vazado. Refresh token abaixo permite renovar sem relogin.
JWT_ACCESS_EXPIRES=15m
# Duracao do refresh token (default 7d)
JWT_REFRESH_EXPIRES=7d
# Habilitar retorno de refresh token no login (default false —
# mantem comportamento legado de token unico 7d. Setar true para
# ativar access 15min + refresh 7d com renovacao via /api/auth/refresh)
ENABLE_REFRESH_TOKENS=false

# ─── Sprint 3 — Robustez (M8/M9) ───────────────────────────────────
# Maximo de candidaturas por vaga (default 50)
MAX_CANDIDATURAS_PER_VAGA=50
# Dias para expirar candidatura pendente automaticamente (default 30)
CANDIDATURA_EXPIRA_DIAS=30

# ─── Sprint 3 — Uploads com auth (U3) ──────────────────────────────
# Default: true — /uploads/ requer autenticacao (admin/prof dono/contratante
# que tem candidatos). Setar false para manter comportamento publico
# (atencao: qualquer um podera baixar diplomas se souber o filename)
AUTH_UPLOADS=true

# ─── Sprint 3 — Rate limit por user (P9) ───────────────────────────
# Ja coberto por RATE_LIMIT_MAX acima — agora usa user.id do JWT quando
# autenticado, fallback para IP quando anonimo. Sem variavel nova.

# ─── Sprint 3 — OpenAPI/Swagger (P10) ─────────────────────────────
# URL base para a spec OpenAPI (default: http://localhost:4000)
# Em producao, setar para o dominio publico do backend
# BACKEND_URL=https://essencia-backend.onrender.com
